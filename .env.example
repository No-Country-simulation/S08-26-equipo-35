# .env.example
# Copia este archivo a .env y rellena los valores reales.
# NUNCA commitees el .env real.

# ============================================================
# BASE DE DATOS
# ============================================================
# Para Docker Compose (servicio interno `db`):
DATABASE_URL=postgresql+psycopg2://splitflow:splitflow_pass@db:5432/splitflow

# Para desarrollo local con Neon (descomenta y usa tu URL real):
# DATABASE_URL=postgresql+psycopg2://usuario:password@host.neon.tech/splitflow_db?sslmode=require

# Variables usadas por docker-compose para el servicio `db`:
POSTGRES_USER=splitflow
POSTGRES_PASSWORD=splitflow_pass
POSTGRES_DB=splitflow

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# AUTENTICACIÓN JWT
# ============================================================
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_in_production_use_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# APLICACIÓN
# ============================================================
APP_ENV=development
DEBUG=true